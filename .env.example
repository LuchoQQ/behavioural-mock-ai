# Required for all environments

# Neon Postgres connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Anthropic API key — used by the evaluator (M2) AND by the ElevenLabs
# agent via "Custom LLM (BYOK)"
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs agent ID from the dashboard (after creating the agent)
ELEVENLABS_AGENT_ID=agent_...

# Shared secret you configure on the ElevenLabs post-call webhook so we
# can verify HMAC signatures
ELEVENLABS_WEBHOOK_SECRET=replace-me

# Optional: only needed if you run local agent-management scripts
# ELEVENLABS_API_KEY=

# Reserved for M3 admin (do not fill yet)
# ADMIN_PASSWORD=
# ADMIN_COOKIE_SECRET=
